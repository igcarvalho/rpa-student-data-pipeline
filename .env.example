# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Nunca commite o arquivo .env (ele está no .gitignore).

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rpa_students
DB_USER=rpa_user
DB_PASSWORD=rpa_password

# --- Diretórios do robô (padrões funcionam com Docker e local) ---
INPUT_DIR=data/input
PROCESSED_DIR=data/processed
OUTPUT_DIR=data/output
LOG_DIR=logs

# --- E-mail (MELHORIA FUTURA: envio do relatório via SMTP) ---
# Desativado por padrão. Quando implementado, estas variáveis serão usadas.
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
